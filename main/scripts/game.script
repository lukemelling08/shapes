local Entity = require("main.modules.entity")
local Renderer = require("main.modules.render")
local Camera = require("main.modules.camera")
local InputHandler = require("main.modules.input_handler")
local EntityType = require("main.modules.entity_type")
local Projectile = require("main.modules.projectile")
local EntityClass = require("main.modules.entity_class")
local Collision = require("main.modules.collision")
local Debris = require("main.modules.debris")

local fixed_dt = 1 / sys.get_config_int("engine.fixed_update_frequency", 60)

function init(self)
	msg.post(".", "acquire_input_focus")
	Renderer:init(msg.url("/renderer#mesh"))
	self.player = Entity:new({type=EntityType.PLAYER, pos={x=0,y=0}})
	Entity.vip.player = self.player
	local player2 = Entity:new({type=EntityType.PLAYER, pos={x=30,y=0}, velocity = {x = 3000, y = 900}, friction = 0.1})
	Camera:follow(self.player)
end

function on_input(self, action_id, action)
	InputHandler:on_input(action_id, action)

	local function fire_projectile()
		local player = Entity.vip.player

		if not InputHandler.mouse.x or not InputHandler.mouse.y then
			return
		end

		local speed = 450

		local velocity = {
			x = math.cos(player.rotation) * speed,
			y = math.sin(player.rotation) * speed
		}

		return  Projectile:fire(EntityClass.BULLET, player, player.pos, player.rotation)
	end

	if action_id == hash("lmb") and action.pressed then
		local projectile = fire_projectile()
	end
end

function update(self, dt)
	Camera:update(dt)
	
	Renderer:clear()
	for _, entity in pairs(Entity.active) do
		entity:render()
	end
	Debris:render()
	Renderer:flush()
end

local counter = 0
function fixed_update(self, dt)
	local expired_entities = {}
	for _, entity in pairs(Entity.active) do
		if entity.lifetime > 0 then
			entity.lifetime = entity.lifetime - dt
			if entity.lifetime <= 0 then
				table.insert(expired_entities, entity)
			end
		end
		
		entity.pos.previous.x = entity.pos.x
		entity.pos.previous.y = entity.pos.y
		entity:update_pos(dt)
	end

	for _, entity in ipairs(expired_entities) do
		entity:remove()
		pprint(entity)
	end
	
	counter = counter +1
	if counter == 240 then
		Entity:new({type=EntityType.PLAYER, pos={x=math.random(-200, 200),y=math.random(-200,200)}, velocity = {x = 3000, y = 900}, friction = 0.1})
		counter = 0
	end
	Collision:update()
	Debris:update(dt)
end
